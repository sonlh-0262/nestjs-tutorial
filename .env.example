# Application
NODE_ENV=development
PORT=3000
APP_NAME=NestJS Tutorial API

# API
API_PREFIX=
SWAGGER_PATH=api
SWAGGER_ENABLED=true

# i18n - supported languages: en, jp
FALLBACK_LANGUAGE=en

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_tutorial
DB_SCHEMA=public
DB_SSL=false
DB_LOGGING=false
DB_HOST_PORT=5432

# Redis
# REDIS_DB is the logical database *index* Redis keeps this app's keys in, not a
# database name. A Redis server ships with 16 of them, numbered 0-15, and 0 is
# the default one - change it only to share a server between apps.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nestjs-tutorial:
REDIS_HOST_PORT=6379

# Authentication
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
JWT_ISSUER=nestjs-tutorial
BCRYPT_SALT_ROUNDS=10
