# Environment for the e2e suite. The Jest CLI sets NODE_ENV=test unless it is
# already set, and `envFilePaths()` then puts this file ahead of `.env` - so
# every key this file does not mention still comes from `.env`. Override
# locally with `.env.test.local`, the only file that outranks this one.
#
# Committed on purpose: it holds no secrets, only the settings that keep the
# suite off the development database.

NODE_ENV=test

# A database of its own. The harness empties every table after each test
# case, so `test/support/test-database.ts` refuses to start unless this name
# ends in `_test` - that suffix is all that stands between a mis-set
# DB_DATABASE and someone's development data.
DB_DATABASE=nestjs_tutorial_test

# The harness deletes every key under REDIS_KEY_PREFIX between test cases, to
# drop revoked tokens, and refuses to start unless that prefix says "test".
# REDIS_DB is a second line of defence rather than the rail: a logical database
# of the suite's own, since index 0 is the application's.
REDIS_DB=1
REDIS_KEY_PREFIX=nestjs-tutorial-test:

# The cheapest cost factor bcrypt accepts. Hashing is the slowest thing the
# suite does and every seeded user pays for it; 10 rounds costs minutes.
BCRYPT_SALT_ROUNDS=4

# `test/app.e2e-spec.ts` asserts the OpenAPI document, so keep Swagger mounted.
SWAGGER_ENABLED=true

# Uploaded files land here instead of next to the development ones. The harness
# deletes this directory between test cases, so it refuses to start unless the
# path ends in "test".
UPLOAD_DIR=uploads/test
